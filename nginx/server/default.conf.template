map $request_method $admin_login_key {
    POST    $binary_remote_addr;
    default '';
}

limit_req_zone $admin_login_key zone=admin_login:10m rate=5r/m;
limit_req_status 429;

server {
    listen 80;
    server_name snipatlas.jensbaumann.com;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name snipatlas.jensbaumann.com;
    server_tokens off;
    client_max_body_size 1m;

    ssl_certificate /etc/letsencrypt/live/snipatlas.jensbaumann.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/snipatlas.jensbaumann.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    location /static/ {
        include /etc/nginx/snippets/security-headers.conf;
        alias /app/staticfiles/;
        expires 30d;
    }

    location = /${ADMIN_PATH}login/ {
        limit_req zone=admin_login burst=3 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://backend:8000;
    }

    location /${ADMIN_PATH} {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://backend:8000;
    }

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://backend:8000;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://frontend:4000;
    }
}
