# Copy to .env and fill in. Never commit .env.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Base of the links in mails (password reset), server: https://snipatlas.jensbaumann.com
FRONTEND_URL=http://localhost:4200
# Server: SECURE_COOKIES=True and CSRF_TRUSTED_ORIGINS=https://snipatlas.jensbaumann.com
SECURE_COOKIES=False
CSRF_TRUSTED_ORIGINS=
# Proxies in front of Django that add X-Forwarded-For (throttling per visitor), server: NUM_PROXIES=1
NUM_PROXIES=0

POSTGRES_DB=snipatlas
POSTGRES_USER=snipatlas
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://snipatlas:change-me@db:5432/snipatlas

# Local: Mailtrap Sandbox, server: Mailtrap Sending. Without EMAIL_BACKEND mails go to the console.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@snipatlas.jensbaumann.com
REPLY_TO_EMAIL=info@example.com
